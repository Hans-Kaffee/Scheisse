{
  "name": "eleckoi-world-engine",
  "version": "1.5.0",
  "type": "module",
  "description": "ElecKoi 开放世界 RP 世界引擎：时间、NPC 日程、触发器、暗线、变量与骰子由代码判定，通过 DSH 工具接入角色扮演流程。内置《德意志帝国 · 2025（总集版）》世界。",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "engine.js",
    "cordis.patch.yml",
    "worlds",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
